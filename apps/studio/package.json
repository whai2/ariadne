{
  "name": "@ariadne/studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Ariadne Studio — 그래프 엔진 위에서 도는 에이전트 admin (React + Vite)",
  "scripts": {
    "dev": "vite build && bun run src/server.ts",
    "dev:ui": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@ariadne/agent": "workspace:*",
    "@ariadne/core": "workspace:*",
    "@ariadne/mcp": "workspace:*",
    "@ariadne/memory": "workspace:*",
    "@ariadne/model": "workspace:*",
    "@ariadne/observability": "workspace:*",
    "@ariadne/tools": "workspace:*",
    "mermaid": "^11.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "zod": "^4.5.4",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0"
  }
}
