{
  "name": "ariadne",
  "version": "0.0.0",
  "private": true,
  "description": "Ariadne — TypeScript 올인원 에이전트 프레임워크 (LangGraph 스타일 그래프 엔진 + Studio). 학습용 모노레포.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '@ariadne/*' typecheck",
    "test": "bun run --filter '@ariadne/*' test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "verify": "bun run typecheck && bun run check && bun run test",
    "studio": "bun run --filter '@ariadne/studio' dev",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.4.0",
    "lefthook": "^2.1.12",
    "typescript": "^7.0.2"
  }
}
