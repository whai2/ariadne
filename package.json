{
  "name": "langgraph-ts",
  "version": "0.0.0",
  "private": true,
  "description": "LangGraph를 TypeScript로 bottom-up 재구현하는 학습 프로젝트",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "verify": "bun run typecheck && bun run check && bun test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.4.0",
    "lefthook": "^2.1.12",
    "typescript": "^7.0.2"
  }
}
